{
  "name": "rae-proxy",
  "productName": "Rae Proxy",
  "version": "1.3.0",
  "description": "Free, open HTTP/HTTPS debugging proxy for macOS — every feature unlocked.",
  "main": "src/main/main.js",
  "author": {
    "name": "musti-91"
  },
  "homepage": "https://github.com/musti-91/reaProxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musti-91/reaProxy.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js && node test/features.js",
    "dist": "electron-builder --mac --arm64",
    "prettier:write": "prettier --write \"src/**/*.{js,ts,tsx,css,scss,md,json}\"",
    "prettier:check": "prettier --check \"src/**/*.{js,ts,tsx,css,scss,md,json}\""
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "app.rae.proxy",
    "productName": "Rae Proxy",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/renderer/logo.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "Mustafa Alroomi (JWKX6RHQWE)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "artifactName": "RaeProxy-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    }
  }
}
